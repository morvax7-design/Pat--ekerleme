<!DOCTYPE html>
<html lang="tr"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>Pat Pat Şekerleme</title>
<style>
:root{--s:46px;--b1:#6a2fb0;--b2:#ff7fc0;--ink:#4a1d63;--pk:#ff4f9a;--gd:#ffc93c}
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent;user-select:none}
html,body{height:100%;overflow:hidden}
body{background:linear-gradient(180deg,var(--b1),var(--b2));font-family:"Trebuchet MS","Segoe UI",system-ui,sans-serif;color:#fff;transition:background .4s}
.scr{position:fixed;inset:0;display:none;flex-direction:column;align-items:center;gap:10px;padding:calc(env(safe-area-inset-top,0px) + 10px) 10px calc(env(safe-area-inset-bottom,0px) + 62px)}
.scr.on{display:flex}
#menu{justify-content:center;gap:14px}
.logo{font-size:44px;font-weight:900;line-height:1.05;text-align:center;text-shadow:0 4px 0 #b5316f,0 8px 16px #0004;animation:bob 2s ease-in-out infinite}
@keyframes bob{50%{transform:translateY(-8px) rotate(1.5deg)}}
.row{font-size:32px;letter-spacing:6px}
.pill{background:#0003;border-radius:20px;padding:5px 14px;font-weight:800}
.btn{display:block;width:100%;max-width:300px;background:linear-gradient(180deg,#ff7ab5,var(--pk));color:#fff;border:0;border-bottom:4px solid #b5316f;border-radius:16px;padding:13px 18px;font:800 16px inherit;font-family:inherit;cursor:pointer;text-shadow:0 1px 2px #0003;margin:3px auto}
.btn:active{transform:translateY(2px);border-bottom-width:2px}
.btn.g{background:linear-gradient(180deg,#5fe08f,#27ae60);border-bottom-color:#17803f}
.btn.y{background:linear-gradient(180deg,#ffe27a,var(--gd));border-bottom-color:#c8870a;color:#5c3a00;text-shadow:none}
.btn.w{background:#fff;color:#c0307a;border-bottom-color:#ffc4e0;text-shadow:none}
.btn.big{font-size:20px;padding:17px}
.hud{display:flex;gap:6px;width:100%;max-width:440px;align-items:stretch}
.hb{flex:1;background:#fff8ec;color:var(--ink);border:3px solid #d4458a;border-radius:13px;text-align:center;padding:3px 2px;box-shadow:0 3px 0 #b5316f}
.hb small{display:block;font-size:10px;font-weight:800;color:#d4458a}
.hb b{font-size:19px}
.ib{width:46px;background:#fff8ec;border:3px solid #d4458a;border-radius:13px;font-size:20px;box-shadow:0 3px 0 #b5316f;cursor:pointer}
.bar{position:relative;width:100%;max-width:440px;height:22px;background:#fff8ec;border:3px solid #e8a91a;border-radius:12px;overflow:hidden}
.bar i{display:block;height:100%;width:0;background:linear-gradient(90deg,#ffc93c,#ffe27a);transition:width .4s}
.bar span{position:absolute;inset:0;text-align:center;font:800 12px/16px inherit;font-family:inherit;color:var(--ink)}
#combo{height:20px;font-weight:900;font-style:italic;text-shadow:0 2px 0 #b5316f;opacity:0;transition:opacity .2s}
#combo.on{opacity:1}
#board{position:relative;overflow:hidden;background:#ffffff38;border:4px solid #fff;border-radius:18px;box-shadow:0 6px 0 #0003;touch-action:none;margin:0 auto}
.t{position:absolute;left:0;top:0;width:var(--s);height:var(--s);display:flex;align-items:center;justify-content:center;transition:transform .22s cubic-bezier(.3,.9,.4,1);z-index:1}
.in{position:relative;isolation:isolate;width:88%;height:88%;border-radius:30%;display:flex;align-items:center;justify-content:center;font-size:calc(var(--s)*.56);box-shadow:inset 0 -3px 0 #0003}